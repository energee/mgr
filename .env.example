# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site URL — REQUIRED for portal invites and magic-link redirect URLs.
# In production, set this to your canonical domain. Falls back to NEXT_PUBLIC_APP_URL
# if unset, but should be explicitly configured for production deployments.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Sentry (optional — error tracking and performance monitoring)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=sntrys_...  # Only needed for source map uploads in CI

# AI Chat (optional — can also be set per-user or globally in system_settings)
# ANTHROPIC_API_KEY=sk-ant-...

# QuickBooks (optional)
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=
# Optional: override the OAuth redirect URI (defaults to current origin + /api/integrations/quickbooks/callback)
# NEXT_PUBLIC_QBO_REDIRECT_URI=

# Square (optional)
# SQUARE_ENVIRONMENT=production
# Optional: override the webhook notification URL used for signature verification
# (defaults to NEXT_PUBLIC_APP_URL + /api/square/webhook)
# SQUARE_WEBHOOK_URL=

# Email (Resend — optional)
# RESEND_API_KEY=           # Get from https://resend.com/api-keys
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# Logging (optional — defaults to "debug" in dev, "info" in production)
# Valid levels: debug, info, warn, error
# LOG_LEVEL=info

# Development endpoints (optional, only in NODE_ENV=development)
ENABLE_DEV_ENDPOINTS=true
