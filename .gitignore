# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.auth/user.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*
.playwright-mcp

# env files (can opt-in for committing if needed)
.env*
!.env.example

# worktrees
.worktrees/

# Claude agent working directory — ignore everything under .claude/ except the
# project-level settings.json (Stop hook, etc.) which travels with the repo.
# Per-developer overrides go in .claude/settings.local.json (still ignored).
/.claude/*
!/.claude/settings.json

# Supabase CLI auto-touches this on every invocation; keep it untracked.
# Other files in supabase/.temp/ (project-ref, version stamps) are tracked
# intentionally so the team shares the same supabase context.
supabase/.temp/cli-latest

# legacy lockfiles
package-lock.json
pnpm-lock.yaml

# pnpm store (legacy)
.pnpm-store/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/
.superpowers/

# Sentry Config File
.env.sentry-build-plugin

# autoharness — runtime workspace state and regenerable onboarding artifacts.
# autoharness.yaml and benchmarks/screening.yaml stay tracked.
.autoharness/
autoharness.project.md
autoharness.claude.md
autoharness.onboarding.json

# Python bytecode (autoharness preflight runs `python -m compileall .`).
__pycache__/
*.pyc
