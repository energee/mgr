# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.eslintcache
/.vitest-reports

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.auth/user.json
e2e/.auth/portal.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*
.playwright-mcp

# env files (can opt-in for committing if needed)
.env*
# belt-and-braces: redundant with .env* above, kept explicit so .local variants
# stay ignored even if the broad pattern is ever narrowed
.env*.local
!.env.example

# worktrees — nested checkouts created by scripts/agent-worktree. Ignore the
# worktrees dir specifically so tracked .agents/skills/ is unaffected.
.worktrees/
/.agents/worktrees/

# Claude agent working directory — ignore everything under .claude/ except the
# project-level settings.json (Stop hook, etc.), the project-scoped expert agents
# under agents/, the repo hooks under hooks/, and the project skills under
# skills/. All four travel with the repo.
# Per-developer overrides go in .claude/settings.local.json (still ignored).
/.claude/*
!/.claude/settings.json
!/.claude/agents/
!/.claude/agents/**
!/.claude/hooks/
!/.claude/hooks/**
!/.claude/skills/
!/.claude/skills/**

# Supabase CLI auto-touches this on every invocation; keep it untracked.
# Other files in supabase/.temp/ (project-ref, version stamps) are tracked
# intentionally so the team shares the same supabase context.
supabase/.temp/cli-latest
supabase/.temp/linked-project.json
supabase/.branches/

# legacy lockfiles
package-lock.json
pnpm-lock.yaml

# pnpm store (legacy)
.pnpm-store/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/
.superpowers/

# Sentry Config File
.env.sentry-build-plugin

# autoharness — runtime workspace state and regenerable onboarding artifacts.
# autoharness.yaml and benchmarks/screening.yaml stay tracked.
.autoharness/
autoharness.project.md
autoharness.claude.md
autoharness.onboarding.json

# Python bytecode (autoharness preflight runs `python -m compileall .`).
__pycache__/
*.pyc
/.agents/worktrees/

# Agentic-workflow outcome markers (read by require-durable-outcome, never committed)
/quiet-run.md
/sentry-outcome.md
/loop-scoreboard.md
# Sentry harness outbox: the uncredentialed agent job's declared outcome, packed
# as a CI artifact for the land-fix job (see .github/scripts/sentry-harness/outbox.ts)
/outbox/
